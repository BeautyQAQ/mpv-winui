<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MpvShell.App.Tests" />
    <ProjectReference Include="..\MpvShell.Player.Abstractions\MpvShell.Player.Abstractions.csproj" />
    <ProjectReference Include="..\MpvShell.Player.LibMpv\MpvShell.Player.LibMpv.csproj" />
    <ProjectReference Include="..\MpvShell.Rendering.WinUI\MpvShell.Rendering.WinUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Native\win-x64\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes\win-x64\native\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\ThirdParty\**\*" />
    <Content Remove="Assets\ThirdParty\**\*" />
    <Content Include="Assets\ThirdParty\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             TargetPath="ThirdParty\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 未打包 WinUI 的应用 PRI 由 MRT Core 生成，但不会自动进入 .NET 发布清单。
       App/MainWindow/PlayerPage 的 XBF 已作为 EmbeddedData 包含在此 PRI 中。 -->
  <Target Name="IncludeAppPriInPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(WindowsPackageType)' == 'None' and '$(AppxGeneratePriEnabled)' == 'true'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="缺少应用 XAML 资源索引，请先完成 WinUI 构建：$(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             RelativePath="$(ProjectPriFileName)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
